# FunASR Docker Configuration
# Copy this file to .env and modify as needed

# Server
FUNASR_HOST_PORT=8000
FUNASR_DEVICE=cpu
FUNASR_MODEL=sensevoice

# Workers: each worker loads ~1.2GB RAM (SenseVoice + CAM++)
# 2 workers = ~2.4GB, 4 workers = ~4.8GB
FUNASR_WORKERS=1

# Access token (API + Web). Leave empty to disable auth.
FUNASR_TOKEN=
